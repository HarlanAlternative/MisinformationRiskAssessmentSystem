# Rendered at container start by the nginx image's envsubst entrypoint, which
# substitutes only variables actually present in the environment. BACKEND_URL has
# a default in the Dockerfile, so docker-compose keeps working unchanged while a
# deployed container can point anywhere. nginx's own runtime variables ($scheme,
# $remote_addr, ...) are not environment variables and are left untouched.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        # $proxy_host, not $host: when proxying to a Container App the upstream
        # routes on the Host header, and forwarding the browser's host would not
        # resolve there.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        # The BERT service scales to zero, so the first analysis after an idle
        # period waits on a cold start.
        proxy_connect_timeout 30s;
        proxy_read_timeout 300s;
    }

    location /swagger/ {
        proxy_pass ${BACKEND_URL}/swagger/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
